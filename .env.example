# QuickDrop Rider Payout Dispute Desk Environment Variables

# Service Port
PORT=8000

# PaySwift Sandbox / Production Base URL
PAYSWIFT_BASE_URL=http://localhost:8081

# Database Configuration (Defaults to local SQLite if omitted)
# DATABASE_URL=postgresql://qd:qd_secret@localhost:5432/quickdrop
SQLITE_DB_PATH=dispute_desk.db

# Optional LLM API Configuration (Agent includes deterministic NLU fallback)
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
